generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String
  username      String    @unique
  email         String    @unique
  passwordHash  String
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  stores        Store[]
  orders        Order[]
  reviews       Review[]
  purchases     Purchase[]
  cart          Cart?
  sellerProfile SellerProfile?
}

model SellerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  storeId            String?  @unique
  payoutPreference   String?
  verificationStatus String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])
}

model Store {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  logo        String?
  banner      String?
  description String?
  socialLinks Json?
  rating      Float    @default(0)
  salesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner             User               @relation(fields: [ownerId], references: [id])
  sellerProfile     SellerProfile?
  products          Product[]
  commissions       Commission[]
  payouts           Payout[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  parentId    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                    String        @id @default(cuid())
  sellerId              String
  storeId               String
  categoryId            String
  title                 String
  slug                  String        @unique
  description           String
  priceInMinor          Int
  status                ProductStatus @default(DRAFT)
  fileType              String
  fileSize              String
  softwareRequirements  String?
  license               String?
  tags                  String[]      @default([])
  rating                Float         @default(0)
  salesCount            Int           @default(0)
  isFeatured            Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  category    Category       @relation(fields: [categoryId], references: [id])
  store       Store          @relation(fields: [storeId], references: [id])
  images      ProductImage[]
  reviews     Review[]
  purchases   Purchase[]
  orderItems  OrderItem[]
  commissions Commission[]
  cartItems   CartItem[]
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  altText     String?
  isThumbnail Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model Cart {
  id        String    @id @default(cuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id                  String      @id @default(cuid())
  buyerId             String
  totalInMinor        Int
  commissionInMinor    Int
  sellerRevenueInMinor Int
  status              OrderStatus @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  buyer      User        @relation(fields: [buyerId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  purchases  Purchase[]
  commissions Commission[]
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String
  sellerId           String
  priceInMinor       Int
  commissionInMinor  Int
  revenueInMinor     Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  provider           String
  providerReference  String?
  amountInMinor      Int
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  orderId   String
  productId String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Commission {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  sellerId    String
  storeId     String
  rate        Int
  amountInMinor Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
}

model SellerBalance {
  id                    String   @id @default(cuid())
  sellerId              String
  availableBalanceInMinor Int
  pendingBalanceInMinor   Int
  paidOutInMinor        Int
  currency              String   @default("THB")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Payout {
  id                  String   @id @default(cuid())
  storeId             String
  amountInMinor       Int
  status              String   @default("PENDING")
  provider            String
  reference           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

model Download {
  id           String   @id @default(cuid())
  userId       String
  purchaseId   String
  productId    String
  signedUrlToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketplaceSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  targetType  String
  targetId    String
  action      String
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
